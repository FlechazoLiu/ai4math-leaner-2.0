POSTGRES_PASSWORD=change_me
AUTH_SECRET=change_me
NEXTAUTH_URL=http://localhost:3000

# Image tags for offline deployment
PG_IMAGE=leaner/postgres:17
LEANER_BE_IMAGE=leaner/leaner-be:latest
LEANER_FE_IMAGE=leaner/leaner-fe:latest
VERIFIER_IMAGE=leaner/verifier:latest

# Verifier runtime settings
LEAN_VERSION=v4.22.0
MATHLIB4_VERSION=v4.22.0
MATHLIB4_RETRY_COUNT=5
MATHLIB4_RETRY_DELAY_SECONDS=10
WORKERS=1
REPO_URL_OR_PATH=/opt/mathlib4

# Verifier memory limits (for servers with limited RAM)
# On 2GB servers, set ENABLE_VERIFIER_PROFILE=false (verifier won't start)
# On 8GB+ servers, set ENABLE_VERIFIER_PROFILE=true and adjust limits below
# ENABLE_VERIFIER_PROFILE=true
# VERIFIER_MEM_LIMIT=2g
# VERIFIER_MEMSWAP_LIMIT=4g

# Database bootstrap settings
DB_BOOTSTRAP_RETRIES=60
DB_BOOTSTRAP_DELAY_SECONDS=2

# Initial admin bootstrap (optional but recommended for new environments)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me_admin_password
